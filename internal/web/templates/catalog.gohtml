{{- /*gotype: albumer/internal/web.pageData*/ -}}
{{define "catalog"}}
{{template "layout_start" .}}
  <header class="page-head">
    <div>
      <h1>{{.Tr "catalog"}}</h1>
      <p>{{.Tr "catalog_intro"}}</p>
    </div>
    <div class="actions">{{template "add_menu" .}}</div>
  </header>
  <form class="filters" method="get" action="/items" data-catalog-filters>
    <label>{{.Tr "search"}} <input type="search" name="q" value="{{.Filter.Query}}" placeholder="{{.Tr "search_catalog"}}"></label>
    <label>{{.Tr "type"}}
      <select name="kind">
        <option value="" {{if eq .Filter.Kind ""}}selected{{end}}>{{.Tr "all"}}</option>
        <option value="music" {{if eq .Filter.Kind "music"}}selected{{end}}>{{.Tr "music"}}</option>
        <option value="book" {{if eq .Filter.Kind "book"}}selected{{end}}>{{.Tr "books"}}</option>
      </select>
    </label>
    <label>{{.Tr "medium"}}
      <select name="medium">
        <option value="" {{if eq .Filter.Medium ""}}selected{{end}}>{{.Tr "all_plural"}}</option>
        <option value="CD" {{if eq .Filter.Medium "CD"}}selected{{end}}>CD</option>
        <option value="VINYL" {{if eq .Filter.Medium "VINYL"}}selected{{end}}>{{.Tr "vinyl"}}</option>
        <option value="CASSETTE" {{if eq .Filter.Medium "CASSETTE"}}selected{{end}}>{{.Tr "cassette"}}</option>
      </select>
    </label>
    <label>{{.Tr "status"}}
      <select name="status">
        <option value="" {{if eq .Filter.Status ""}}selected{{end}}>{{.Tr "all_plural"}}</option>
        <option value="owned" {{if eq .Filter.Status "owned"}}selected{{end}}>{{.Tr "status.owned"}}</option>
        <option value="ordered" {{if eq .Filter.Status "ordered"}}selected{{end}}>{{.Tr "status.ordered"}}</option>
        <option value="wanted" {{if eq .Filter.Status "wanted"}}selected{{end}}>{{.Tr "status.wanted"}}</option>
      </select>
    </label>
    <fieldset class="view-switch">
      <legend>{{.Tr "view"}}</legend>
      <div class="view-options">
        <label title="{{.Tr "view_grid"}}">
          <input type="radio" name="view" value="grid" {{if eq .Filter.View "grid"}}checked{{end}}>
          <span class="view-option">{{template "icon-grid"}}<span class="sr-only">{{.Tr "view_grid"}}</span></span>
        </label>
        <label title="{{.Tr "view_list"}}">
          <input type="radio" name="view" value="list" {{if eq .Filter.View "list"}}checked{{end}}>
          <span class="view-option">{{template "icon-list"}}<span class="sr-only">{{.Tr "view_list"}}</span></span>
        </label>
      </div>
    </fieldset>
  </form>
  <div id="catalog-results">{{template "catalog_items" .}}</div>
{{template "layout_end" .}}
{{end}}

{{define "catalog_items"}}
  {{if .Items}}
  <section class="catalog {{.Filter.View}}">
  {{range .Items}}
    <article class="item-card">
      <div class="item-cover">
        {{if .CoverPath}}
          <img src="{{.CoverPath}}" alt="">
        {{else if eq .Kind "book"}}
          <img src="/assets/default-book.svg" alt="">
        {{else if eq .Medium "VINYL"}}
          <img src="/assets/default-vinyl.svg" alt="">
        {{else if eq .Medium "CASSETTE"}}
          <img src="/assets/default-cassette.svg" alt="">
        {{else}}
          <img src="/assets/default-cd.svg" alt="">
        {{end}}
      </div>
      <div class="item-body">
        <h2 class="item-title">{{.Title}}</h2>
        {{if .Subtitle}}<div class="item-meta">{{.Subtitle}}</div>{{end}}
        <div class="badges">
          {{if eq .Kind "book"}}<span class="badge">{{$.Tr "book"}}</span>{{else}}<span class="badge medium">{{.Medium}}</span>{{end}}
          {{if .Status}}<span class="badge">{{$.StatusLabel .Status}}</span>{{end}}
        </div>
        <a class="button icon-button" href="{{if eq .Kind "book"}}/books/{{pathEscape .ID}}/edit{{else}}/music/{{pathEscape .ID}}/edit{{end}}" title="{{$.Tr "edit"}}" aria-label="{{$.Tr "edit"}}">{{template "icon-pencil"}}</a>
      </div>
    </article>
  {{end}}
  </section>
  {{else}}
    <div class="empty">{{.Tr "empty_catalog"}}</div>
  {{end}}
{{end}}
