{{- /*gotype: albumer/internal/web.pageData*/ -}}
{{define "people_index"}}
{{template "layout_start" .}}
  <header class="page-head">
    <div>
      <h1>Osoby</h1>
      <p>Artysci muzyczni i autorzy ksiazek.</p>
    </div>
    <a class="button primary" href="/people/new">Dodaj osobe</a>
  </header>
  <section class="manage-search" data-list-filter>
    <input type="search" placeholder="Szukaj osob" aria-label="Szukaj osob" data-list-filter-input>
  </section>
  <section class="manage-list" data-list-filter-list>
    {{range .People}}
      <article class="manage-row" data-list-filter-item data-filter-label="{{.Name}} {{.SortName}}">
        <div>
          <h2>{{.Name}}</h2>
          {{if .SortName}}<p>{{.SortName}}</p>{{end}}
        </div>
        <a class="button small" href="/people/{{pathEscape .ID}}/edit">Edytuj</a>
      </article>
    {{else}}
      <div class="empty">Brak osob.</div>
    {{end}}
    <div class="empty" data-list-filter-empty hidden>Brak pasujacych osob.</div>
  </section>
{{template "layout_end" .}}
{{end}}

{{define "groups_index"}}
{{template "layout_start" .}}
  <header class="page-head">
    <div>
      <h1>Zespoly</h1>
      <p>Zespoly i sklady powiazane z osobami.</p>
    </div>
    <a class="button primary" href="/groups/new">Dodaj zespol</a>
  </header>
  <section class="manage-search" data-list-filter>
    <input type="search" placeholder="Szukaj zespolow" aria-label="Szukaj zespolow" data-list-filter-input>
  </section>
  <section class="manage-list" data-list-filter-list>
    {{range .Groups}}
      <article class="manage-row" data-list-filter-item data-filter-label="{{.Name}} {{.SortName}}">
        <div>
          <h2>{{.Name}}</h2>
          {{if .SortName}}<p>{{.SortName}}</p>{{end}}
        </div>
        <a class="button small" href="/groups/{{pathEscape .ID}}/edit">Edytuj</a>
      </article>
    {{else}}
      <div class="empty">Brak zespolow.</div>
    {{end}}
    <div class="empty" data-list-filter-empty hidden>Brak pasujacych zespolow.</div>
  </section>
{{template "layout_end" .}}
{{end}}
