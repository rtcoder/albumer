{{- /*gotype: albumer/internal/web.pageData*/ -}}
{{define "people_index"}}
{{template "layout_start" .}}
  <header class="page-head">
    <div>
      <h1>{{.Tr "people"}}</h1>
      <p>{{.Tr "people_intro"}}</p>
    </div>
    {{template "add_menu" .}}
  </header>
  <section class="manage-search" data-list-filter>
    <input type="search" placeholder="{{.Tr "search_people"}}" aria-label="{{.Tr "search_people"}}" data-list-filter-input>
    <select aria-label="{{.Tr "filter_person_type"}}" data-list-filter-type>
      <option value="">{{.Tr "all_person_types"}}</option>
      <option value="artist">{{.Tr "person_type.artist"}}</option>
      <option value="author">{{.Tr "person_type.author"}}</option>
    </select>
  </section>
  <section class="manage-list" data-list-filter-list>
    {{range .People}}
      <article class="manage-row people-row" data-list-filter-item data-filter-label="{{.Name}} {{.SortName}}" data-filter-types="{{range .Roles}}{{.}} {{end}}">
        <div class="manage-row-main">
          <h2>{{.Name}}</h2>
          {{if .SortName}}<p>{{.SortName}}</p>{{end}}
          <div class="person-roles">
            {{if .HasRole "artist"}}<span class="badge">{{$.Tr "person_type.artist"}}</span>{{end}}
            {{if .HasRole "author"}}<span class="badge">{{$.Tr "person_type.author"}}</span>{{end}}
          </div>
        </div>
        <div class="manage-counts">
          {{if .HasRole "artist"}}<span>{{$.Tr "albums"}} <strong>{{.AlbumCount}}</strong></span>{{end}}
          {{if .HasRole "author"}}<span>{{$.Tr "books"}} <strong>{{.BookCount}}</strong></span>{{end}}
        </div>
        <a class="button icon-button" href="/people/{{pathEscape .ID}}/edit" title="{{$.Tr "edit"}}" aria-label="{{$.Tr "edit"}}">{{template "icon-pencil"}}</a>
      </article>
    {{else}}
      <div class="empty">{{.Tr "no_people"}}</div>
    {{end}}
    <div class="empty" data-list-filter-empty hidden>{{.Tr "no_matching_people"}}</div>
  </section>
{{template "layout_end" .}}
{{end}}

{{define "groups_index"}}
{{template "layout_start" .}}
  <header class="page-head">
    <div>
      <h1>{{.Tr "groups"}}</h1>
      <p>{{.Tr "groups_intro"}}</p>
    </div>
    {{template "add_menu" .}}
  </header>
  <section class="manage-search" data-list-filter>
    <input type="search" placeholder="{{.Tr "search_groups"}}" aria-label="{{.Tr "search_groups"}}" data-list-filter-input>
  </section>
  <section class="manage-list" data-list-filter-list>
    {{range .Groups}}
      <article class="manage-row" data-list-filter-item data-filter-label="{{.Name}} {{.SortName}}">
        <div>
          <h2>{{.Name}}</h2>
          {{if .SortName}}<p>{{.SortName}}</p>{{end}}
        </div>
        <a class="button icon-button" href="/groups/{{pathEscape .ID}}/edit" title="{{$.Tr "edit"}}" aria-label="{{$.Tr "edit"}}">{{template "icon-pencil"}}</a>
      </article>
    {{else}}
      <div class="empty">{{.Tr "no_groups"}}</div>
    {{end}}
    <div class="empty" data-list-filter-empty hidden>{{.Tr "no_matching_groups"}}</div>
  </section>
{{template "layout_end" .}}
{{end}}
