{{- /*gotype: albumer/internal/web.pageData*/ -}}
{{define "login"}}
<!doctype html>
<html lang="{{.Lang}}" data-theme="{{.Theme}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} - Albumer</title>
  <link rel="icon" href="/favicon/favicon.ico">
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
  <main class="login-screen">
    <form class="login-card" method="post" action="/login">
      <div class="login-preferences">
        <nav class="segmented-switch login-language" aria-label="{{.Tr "language"}}">
          <a class="{{if eq .Lang "pl"}}active{{end}}" href="/language/pl?next={{.NextURL}}">PL</a>
          <a class="{{if eq .Lang "en"}}active{{end}}" href="/language/en?next={{.NextURL}}">EN</a>
        </nav>
        <nav class="segmented-switch theme-switch" aria-label="{{.Tr "theme"}}">
          <a class="{{if eq .Theme "light"}}active{{end}}" href="/theme/light?next={{.NextURL}}" title="{{.Tr "theme.light"}}" aria-label="{{.Tr "theme.light"}}">{{template "icon-sun"}}</a>
          <a class="{{if eq .Theme "dark"}}active{{end}}" href="/theme/dark?next={{.NextURL}}" title="{{.Tr "theme.dark"}}" aria-label="{{.Tr "theme.dark"}}">{{template "icon-moon"}}</a>
        </nav>
      </div>
      <h1>Albumer</h1>
      <p class="small-note">{{.Tr "private_collection_panel"}}</p>
      {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
      <label>{{.Tr "password"}} <input type="password" name="password" autofocus autocomplete="current-password"></label>
      <button class="button primary" type="submit">{{.Tr "sign_in"}}</button>
    </form>
  </main>
</body>
</html>
{{end}}
